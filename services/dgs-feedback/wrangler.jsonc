{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dgs-feedback-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GITHUB_OWNER": "arjanbekaa",
    "GITHUB_REPO": "dgs-ai-reports",
    "GITHUB_BRANCH": "main"
  },
  "ratelimits": [
    {
      "name": "INSTALL_RATE_LIMITER",
      "namespace_id": "38448201",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "38448202",
      "simple": {
        "limit": 25,
        "period": 60
      }
    }
  ]
}
